cat > ~/fix-delete-button.sh << 'FIXSCRIPT'
#!/usr/bin/env bash
set -euo pipefail
echo "🔧 Fixing delete button and preview window..."

BASE="$HOME/library"

# Updated dropzone.js with working delete button + larger preview
cat > "$BASE/backend/static/js/dropzone.js" << 'EOF'
const UPLOAD_ENDPOINT = '/api/import/upload';
const ITEMS_ENDPOINT = '/api/items';
const HEALTH_ENDPOINT = '/api/health';
const PEERS_ENDPOINT = '/api/mesh/peers';
const FILES_ENDPOINT = '/api/files';

const dropZone = document.getElementById('drop-zone');
const fileInput = document.getElementById('file-input');
const uploadProgress = document.getElementById('upload-progress');
const progressFill = document.getElementById('progress-fill');
const progressText = document.getElementById('progress-text');
const itemsList = document.getElementById('items-list');
const filterType = document.getElementById('filter-type');
const refreshBtn = document.getElementById('refresh-btn');
const previewModal = document.getElementById('preview-modal');
const previewBody = document.getElementById('preview-body');
const totalItemsEl = document.getElementById('total-items');
const jsonCountEl = document.getElementById('json-count');
const mediaCountEl = document.getElementById('media-count');
const peerCountEl = document.getElementById('peer-count');
const meshStatusEl = document.getElementById('mesh-status');

let allItems = [];

dropZone.addEventListener('click', () => fileInput.click());
dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-over'); });
dropZone.addEventListener('dragleave', () => { dropZone.classList.remove('drag-over'); });
dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    const files = e.dataTransfer.files;
    if (files.length > 0) handleFiles(files);
});
fileInput.addEventListener('change', (e) => {
    const files = e.target.files;
    if (files.length > 0) handleFiles(files);
    fileInput.value = '';
});

async function handleFiles(files) {
    for (const file of files) await uploadFile(file);
    await loadItems();
}

async function uploadFile(file) {
    const formData = new FormData();
    formData.append('file', file);
    uploadProgress.style.display = 'block';
    progressFill.style.width = '0%';
    progressText.textContent = 'Uploading ' + file.name + '...';
    const xhr = new XMLHttpRequest();
    xhr.upload.addEventListener('progress', (e) => {
        if (e.lengthComputable) progressFill.style.width = ((e.loaded / e.total) * 100) + '%';
    });
    xhr.addEventListener('load', () => {
        if (xhr.status === 200) {
            progressText.textContent = '✅ ' + file.name + ' uploaded!';
            progressFill.style.backgroundColor = '#10b981';
            setTimeout(() => { uploadProgress.style.display = 'none'; progressFill.style.width = '0%'; progressFill.style.backgroundColor = '#3b82f6'; }, 2000);
        } else {
            progressText.textContent = '❌ Upload failed';
            progressFill.style.backgroundColor = '#ef4444';
        }
    });
    xhr.open('POST', UPLOAD_ENDPOINT);
    xhr.send(formData);
}

async function loadItems() {
    const fileType = filterType.value;
    const url = fileType ? ITEMS_ENDPOINT + '?file_type=' + fileType : ITEMS_ENDPOINT;
    itemsList.innerHTML = '<div class="loading-state">Loading...</div>';
    try {
        const response = await fetch(url);
        const data = await response.json();
        allItems = data.items || [];
        updateStats(data);
        renderItems(allItems);
    } catch (error) {
        console.error('Load error:', error);
        itemsList.innerHTML = '<div class="empty-state"><p>Failed to load items</p></div>';
    }
}

function updateStats(data) {
    totalItemsEl.textContent = data.total || 0;
    const jsonCount = (data.items || []).filter(i => i.file_type === '.json').length;
    const mediaCount = (data.items || []).filter(i => ['.mp4','.webm','.png','.jpg','.pdf'].includes(i.file_type)).length;
    jsonCountEl.textContent = jsonCount;
    mediaCountEl.textContent = mediaCount;
}

function renderItems(items) {
    if (!items || items.length === 0) {
        itemsList.innerHTML = '<div class="empty-state"><div class="empty-state-icon">💧</div><p>No items yet. Drop files above!</p></div>';
        return;
    }
    let html = '';
    for (const item of items) {
        html += '<div class="item-card" onclick="showPreview(' + item.id + ')">';
        html += '<div class="item-icon">' + getFileIcon(item.file_type) + '</div>';
        html += '<div class="item-info">';
        html += '<div class="item-name">' + escapeHtml(item.filename) + '</div>';
        html += '<div class="item-meta">';
        html += '<span>' + item.file_type.toUpperCase() + '</span>';
        html += '<span>' + formatSize(item.file_size) + '</span>';
        html += '<span>' + formatDate(item.timestamp) + '</span>';
        html += '<span class="item-chain">#' + (item.chain_position || '?') + '</span>';
        html += '</div></div>';
        html += '<div class="item-size">' + item.source_laptop + '</div>';
        html += '</div>';
    }
    itemsList.innerHTML = html;
}

async function showPreview(itemId) {
    const item = allItems.find(i => i.id === itemId);
    if (!item) {
        previewBody.innerHTML = '<p>Item not found</p>';
        previewModal.style.display = 'flex';
        return;
    }
    
    // HEADER with buttons
    let html = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">';
    html += '<h2 style="font-size:1.5rem;margin:0;">' + escapeHtml(item.filename) + '</h2>';
    html += '<div style="display:flex;gap:0.75rem;flex-wrap:wrap;">';
    html += '<a href="' + FILES_ENDPOINT + '/' + item.id + '" download style="background:#3b82f6;color:white;padding:0.75rem 1.5rem;border-radius:8px;text-decoration:none;font-weight:600;">⬇️ Download</a>';
    html += '<button onclick="deleteItem(' + item.id + ',\'' + escapeHtml(item.filename).replace(/'/g, "\\'") + '\')" style="background:#ef4444;color:white;padding:0.75rem 1.5rem;border:none;border-radius:8px;font-weight:600;cursor:pointer;">🗑️ Delete</button>';
    html += '</div></div>';
    
    // META INFO
    html += '<div style="background:#1e293b;padding:1rem;border-radius:8px;margin-bottom:1.5rem;">';
    html += '<div style="display:flex;gap:2rem;flex-wrap:wrap;">';
    html += '<div><span style="color:#94a3b8;">Type:</span> <strong>' + item.file_type.toUpperCase() + '</strong></div>';
    html += '<div><span style="color:#94a3b8;">Size:</span> <strong>' + formatSize(item.file_size) + '</strong></div>';
    html += '<div><span style="color:#94a3b8;">Chain:</span> <strong>#' + (item.chain_position || '?') + '</strong></div>';
    html += '<div><span style="color:#94a3b8;">Source:</span> <strong>' + item.source_laptop + '</strong></div>';
    html += '</div></div>';
    
    // MEDIA PREVIEW
    if (['.mp4', '.webm'].includes(item.file_type)) {
        html += '<div style="margin-top:1rem;">';
        html += '<video controls autoplay style="width:100%;max-height:600px;background:#000;border-radius:8px;">';
        html += '<source src="' + FILES_ENDPOINT + '/' + item.id + '" type="' + (item.file_type === '.mp4' ? 'video/mp4' : 'video/webm') + '">';
        html += 'Your browser does not support video playback.';
        html += '</video>';
        html += '</div>';
    }
    else if (['.png', '.jpg', '.jpeg'].includes(item.file_type)) {
        html += '<div style="margin-top:1rem;text-align:center;">';
        html += '<img src="' + FILES_ENDPOINT + '/' + item.id + '" style="max-width:100%;max-height:600px;border-radius:8px;">';
        html += '</div>';
    }
    else if (item.file_type === '.pdf') {
        html += '<div style="padding:2rem;text-align:center;background:#1e293b;border-radius:8px;margin-top:1rem;">';
        html += '<div style="font-size:3rem;margin-bottom:1rem;">📕</div>';
        html += '<p style="color:#94a3b8;">PDF files open best in an external viewer.</p>';
        html += '<p style="margin-top:1rem;"><strong>Click the Download button above.</strong></p>';
        html += '</div>';
    }
    else if (['.mp3', '.wav'].includes(item.file_type)) {
        html += '<div style="margin-top:1rem;">';
        html += '<audio controls autoplay style="width:100%;">';
        html += '<source src="' + FILES_ENDPOINT + '/' + item.id + '" type="' + (item.file_type === '.mp3' ? 'audio/mpeg' : 'audio/wav') + '">';
        html += 'Your browser does not support audio playback.';
        html += '</audio>';
        html += '</div>';
    }
    else if (item.file_type === '.json') {
        if (item.title) html += '<p style="margin-bottom:0.5rem;"><strong>Title:</strong> ' + escapeHtml(item.title) + '</p>';
        if (item.message_count) html += '<p style="margin-bottom:0.5rem;"><strong>Messages:</strong> ' + item.message_count + '</p>';
        try {
            const response = await fetch(FILES_ENDPOINT + '/' + item.id + '/content');
            const data = await response.json();
            if (data.content) {
                html += '<div style="margin-top:1rem;">';
                html += '<h3 style="color:#3b82f6;margin-bottom:0.5rem;">📄 Content</h3>';
                html += '<pre style="white-space:pre-wrap;font-family:monospace;font-size:0.85rem;background:#0f172a;padding:1rem;border-radius:8px;border:1px solid #475569;max-height:500px;overflow-y:auto;color:#f1f5f9;">' + escapeHtml(data.content) + '</pre>';
                html += '</div>';
            }
        } catch (e) {
            html += '<p style="color:#94a3b8;">Download the file to view its contents.</p>';
        }
    }
    else {
        html += '<p style="margin-top:1rem;">Download to view this file type.</p>';
    }
    
    // CLOSE BUTTON
    html += '<button onclick="closePreview()" style="margin-top:1.5rem;width:100%;padding:1rem;background:#3b82f6;color:white;border:none;border-radius:8px;cursor:pointer;font-size:1rem;font-weight:600;">Close</button>';
    
    previewBody.innerHTML = html;
    previewModal.style.display = 'flex';
}

async function deleteItem(itemId, filename) {
    if (!confirm('⚠️  DELETE THIS FILE?\n\n"' + filename + '"\n\nThis CANNOT be undone!')) {
        return;
    }
    try {
        const response = await fetch(FILES_ENDPOINT + '/' + itemId, { method: 'DELETE' });
        const data = await response.json();
        if (data.status === 'deleted') {
            alert('✅ File deleted successfully!');
            closePreview();
            await loadItems();
        } else {
            alert('❌ Delete failed: ' + (data.detail || 'Unknown error'));
        }
    } catch (error) {
        alert('❌ Delete error: ' + error.message);
    }
}

function closePreview() { previewModal.style.display = 'none'; }
previewModal.addEventListener('click', (e) => { if (e.target === previewModal) closePreview(); });

async function checkMeshStatus() {
    try {
        const responses = await Promise.all([fetch(HEALTH_ENDPOINT), fetch(PEERS_ENDPOINT)]);
        const health = await responses[0].json();
        const peers = await responses[1].json();
        meshStatusEl.textContent = '🟢 Connected';
        meshStatusEl.style.color = '#10b981';
        peerCountEl.textContent = peers.peers ? peers.peers.length : 0;
    } catch (error) {
        meshStatusEl.textContent = '🔴 Disconnected';
        meshStatusEl.style.color = '#ef4444';
        peerCountEl.textContent = '0';
    }
}

function getFileIcon(fileType) {
    const icons = {'.json':'📄','.mp4':'🎬','.webm':'🎬','.png':'🖼️','.jpg':'🖼️','.jpeg':'🖼️','.pdf':'📕','.mp3':'🎵','.wav':'🎵','.txt':'📝','.md':'📝'};
    return icons[fileType] || '📁';
}

function formatSize(bytes) {
    if (!bytes || isNaN(bytes)) return 'Unknown';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}

function formatDate(isoString) {
    if (!isoString) return 'Unknown';
    const date = new Date(isoString);
    return date.toLocaleDateString() + ' ' + date.toLocaleTimeString();
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

refreshBtn.addEventListener('click', loadItems);
filterType.addEventListener('change', loadItems);
loadItems();
checkMeshStatus();
setInterval(checkMeshStatus, 10000);
EOF

# Update CSS for larger preview modal
cat > "$BASE/backend/static/css/style.css" << 'EOF'
:root {
    --primary: #3b82f6; --primary-dark: #2563eb; --success: #10b981;
    --warning: #f59e0b; --danger: #ef4444; --bg: #0f172a; --bg-card: #1e293b;
    --bg-hover: #334155; --text: #f1f5f9; --text-muted: #94a3b8; --border: #475569;
    --radius: 8px;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; min-height: 100vh; }
.container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
header { margin-bottom: 2rem; }
header h1 { font-size: 2rem; margin-bottom: 1rem; }
.status-bar { display: flex; gap: 2rem; flex-wrap: wrap; }
.status-item { display: flex; gap: 0.5rem; align-items: center; }
.status-item .label { color: var(--text-muted); }
.status-item .value { font-weight: 600; }
.drop-zone { border: 3px dashed var(--border); border-radius: var(--radius); padding: 4rem 2rem; text-align: center; transition: all 0.3s; background: var(--bg-card); cursor: pointer; }
.drop-zone:hover, .drop-zone.drag-over { border-color: var(--primary); background: var(--bg-hover); transform: scale(1.01); }
.drop-zone-content { pointer-events: none; }
.drop-icon { font-size: 4rem; display: block; margin-bottom: 1rem; }
.drop-zone h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
.drop-hint { color: var(--text-muted); margin-bottom: 0.25rem; }
.drop-hint-small { color: var(--text-muted); font-size: 0.875rem; }
.upload-progress { margin-top: 1rem; padding: 1rem; background: var(--bg-card); border-radius: var(--radius); }
.progress-bar { height: 8px; background: var(--bg-hover); border-radius: 4px; overflow: hidden; margin-bottom: 0.5rem; }
.progress-fill { height: 100%; background: var(--primary); width: 0%; transition: width 0.3s; }
.stats-section { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
.stat-card { background: var(--bg-card); padding: 1.5rem; border-radius: var(--radius); text-align: center; border: 1px solid var(--border); }
.stat-number { display: block; font-size: 2.5rem; font-weight: 700; color: var(--primary); }
.stat-label { color: var(--text-muted); font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; }
.items-section { background: var(--bg-card); border-radius: var(--radius); padding: 1.5rem; border: 1px solid var(--border); }
.items-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem; }
.items-header h2 { font-size: 1.25rem; }
.filter-controls { display: flex; gap: 0.5rem; align-items: center; }
.filter-controls select { padding: 0.5rem 1rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); }
.btn { padding: 0.5rem 1rem; background: var(--primary); border: none; border-radius: var(--radius); color: var(--text); cursor: pointer; }
.btn:hover { background: var(--primary-dark); }
.btn-danger { background: var(--danger); }
.btn-danger:hover { background: #dc2626; }
.items-list { display: flex; flex-direction: column; gap: 0.75rem; }
.item-card { background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; display: flex; align-items: center; gap: 1rem; transition: all 0.2s; cursor: pointer; }
.item-card:hover { border-color: var(--primary); background: var(--bg-hover); transform: translateX(4px); }
.item-icon { font-size: 2rem; width: 50px; text-align: center; }
.item-info { flex: 1; min-width: 0; }
.item-name { font-weight: 600; margin-bottom: 0.25rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.item-meta { font-size: 0.75rem; color: var(--text-muted); display: flex; gap: 1rem; flex-wrap: wrap; }
.item-chain { background: var(--primary); color: white; padding: 0.125rem 0.5rem; border-radius: 4px; font-size: 0.75rem; font-weight: 600; }
.preview-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.9); display: flex; align-items: center; justify-content: center; z-index: 1000; }
.preview-content { background: var(--bg-card); border-radius: var(--radius); padding: 2.5rem; max-width: 1000px; width: 90%; max-height: 90vh; overflow-y: auto; position: relative; border: 2px solid var(--border); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); }
.close-btn { position: absolute; top: 1.5rem; right: 1.5rem; background: none; border: none; color: var(--text); font-size: 2rem; cursor: pointer; line-height: 1; }
.close-btn:hover { color: var(--danger); }
.loading-state, .empty-state { text-align: center; padding: 2rem; color: var(--text-muted); }
.empty-state-icon { font-size: 3rem; margin-bottom: 1rem; }
EOF

chmod 644 "$BASE/backend/static/js/dropzone.js"
chmod 644 "$BASE/backend/static/css/style.css"

echo "✅ Delete button and preview window fixed!"
echo ""
echo "Restarting server..."
~/library-manager/stop-all.sh
~/library-manager/start-all.sh

echo ""
echo "🎉 Fixes applied!"
echo "   - Delete button now visible (🗑️)"
echo "   - Preview window larger (90% width, 90% height)"
echo "   - Download button more visible"
echo "   - Better layout with meta info bar"
echo ""
echo "Refresh browser: http://localhost:8771"
echo "Click on any file to see the new preview!"
FIXSCRIPT

chmod +x ~/fix-delete-button.sh
~/fix-delete-button.sh
