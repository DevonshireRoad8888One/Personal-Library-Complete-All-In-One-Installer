cat > ~/fix-modal-v11.7b.sh << 'FIXSCRIPT'
#!/usr/bin/env bash
set -euo pipefail
echo "🔧 Applying v11.7b modal & delete fixes..."

BASE="$HOME/library"

# 1. UPDATE main.py — add delete endpoint (idempotent)
if ! grep -q "delete_item_endpoint" "$BASE/backend/app/main.py"; then
cat >> "$BASE/backend/app/main.py" << 'PYEOF'

# ─────────────────────────────────────────────────────────────
# Delete endpoint (v11.7b)
# ─────────────────────────────────────────────────────────────
from backend.app.db import get_item_by_id, delete_item as db_delete_item
import os as os_mod

@app.delete("/api/items/{item_id}")
async def delete_item_endpoint(item_id: int):
    """Delete a library item (file + database record)"""
    item = await get_item_by_id(item_id)
    if not item:
        raise HTTPException(status_code=404, detail="Item not found")
    # Remove file from disk
    try:
        if os_mod.path.exists(item.file_path):
            os_mod.remove(item.file_path)
    except Exception as e:
        print(f"Warning: could not delete file: {e}")
    # Remove from database
    await db_delete_item(item_id)
    return {"status": "deleted", "item_id": item_id, "filename": item.filename}
PYEOF
echo "  ✅ Added DELETE endpoint"
fi

# 2. UPDATE db.py — ensure delete_item function exists
if ! grep -q "async def delete_item" "$BASE/backend/app/db.py"; then
cat >> "$BASE/backend/app/db.py" << 'PYEOF'

async def delete_item(item_id: int):
    """Delete an item from the database"""
    async with AsyncSessionLocal() as session:
        item = await session.get(LibraryItem, item_id)
        if item:
            await session.delete(item)
            await session.commit()
            return True
        return False
PYEOF
echo "  ✅ Added delete_item function to db.py"
fi

# 3. REPLACE dropzone.js with v11.7b version (with delete button + larger modal)
cat > "$BASE/backend/static/js/dropzone.js" << 'JSEOF'
/**
 * Personal Library v11.7b — Drop Zone + Preview + Delete
 */
const dropZone = document.getElementById('drop-zone');
const fileInput = document.getElementById('file-input');
const itemsList = document.getElementById('items-list');
const previewModal = document.getElementById('preview-modal');
const previewBody = document.getElementById('preview-body');
const refreshBtn = document.getElementById('refresh-btn');
const filterType = document.getElementById('filter-type');
const meshStatusEl = document.getElementById('mesh-status');
const peerCountEl = document.getElementById('peer-count');

const API_BASE = window.location.origin;
const HEALTH_ENDPOINT = `${API_BASE}/api/health`;
const PEERS_ENDPOINT = `${API_BASE}/api/mesh/peers`;
const ITEMS_ENDPOINT = `${API_BASE}/api/items`;

// ─────────────────────────────────────────────────────────────
// Drag & Drop Upload
// ─────────────────────────────────────────────────────────────
dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('dragover');
});
dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('dragover');
});
dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    const files = e.dataTransfer.files;
    for (const file of files) {
        uploadFile(file);
    }
});
dropZone.addEventListener('click', () => fileInput.click());
fileInput.addEventListener('change', (e) => {
    for (const file of e.target.files) {
        uploadFile(file);
    }
});

async function uploadFile(file) {
    const formData = new FormData();
    formData.append('file', file);
    const progressDiv = document.createElement('div');
    progressDiv.className = 'upload-progress';
    progressDiv.innerHTML = `
        <div class="progress-bar"><div class="progress-fill"></div></div>
        <p>Uploading ${escapeHtml(file.name)}...</p>
    `;
    dropZone.appendChild(progressDiv);

    try {
        const response = await fetch(`${API_BASE}/api/import/upload`, {
            method: 'POST',
            body: formData
        });
        const result = await response.json();
        if (result.status === 'accepted') {
            progressDiv.innerHTML = `<p style="color: #10b981;">✅ ${escapeHtml(file.name)} uploaded (${formatSize(file.size)})</p>`;
        } else if (result.status === 'duplicate') {
            progressDiv.innerHTML = `<p style="color: #f59e0b;">⚠️ ${escapeHtml(file.name)} already in library</p>`;
        }
        setTimeout(() => progressDiv.remove(), 3000);
        loadItems();
    } catch (error) {
        progressDiv.innerHTML = `<p style="color: #ef4444;">❌ Upload failed: ${error.message}</p>`;
    }
}

// ─────────────────────────────────────────────────────────────
// Load Items
// ─────────────────────────────────────────────────────────────
async function loadItems() {
    try {
        const fileType = filterType.value;
        const url = fileType ? `${ITEMS_ENDPOINT}?file_type=${encodeURIComponent(fileType)}` : ITEMS_ENDPOINT;
        const response = await fetch(url);
        const data = await response.json();
        renderItems(data.items || []);
        updateStats(data.items || []);
    } catch (error) {
        console.error('Failed to load items:', error);
    }
}

function renderItems(items) {
    if (items.length === 0) {
        itemsList.innerHTML = '<div class="empty-state"><div class="empty-state-icon">📭</div><p>No files yet. Drop files into the zone above to get started.</p></div>';
        return;
    }
    itemsList.innerHTML = items.map(item => `
        <div class="item-card" onclick="showPreview(${item.id})">
            <div class="item-icon">${getFileIcon(item.file_type)}</div>
            <div class="item-info">
                <div class="item-title">${escapeHtml(item.filename)}</div>
                <div class="item-meta">
                    <span class="item-type">${item.file_type.toUpperCase()}</span>
                    <span class="item-size">${formatSize(item.file_size)}</span>
                    <span class="item-date">${formatDate(item.timestamp)}</span>
                    <span class="item-chain">#${item.chain_position}</span>
                </div>
                <div class="item-source">📡 ${escapeHtml(item.source_laptop || 'unknown')}</div>
            </div>
        </div>
    `).join('');
}

function updateStats(items) {
    const total = items.length;
    const jsonCount = items.filter(i => i.file_type === '.json').length;
    const mediaCount = items.filter(i => ['.mp4','.webm','.png','.jpg','.jpeg','.pdf','.mp3','.wav'].includes(i.file_type)).length;
    document.getElementById('total-items').textContent = total;
    document.getElementById('json-count').textContent = jsonCount;
    document.getElementById('media-count').textContent = mediaCount;
}

// ─────────────────────────────────────────────────────────────
// Preview Modal — v11.7b (LARGE modal + delete button)
// ─────────────────────────────────────────────────────────────
async function showPreview(itemId) {
    try {
        const response = await fetch(`${API_BASE}/api/items`);
        const data = await response.json();
        const item = data.items.find(i => i.id === itemId);
        if (!item) return;

        const fileUrl = `${API_BASE}/api/files/${itemId}`;
        let mediaHtml = '';

        if (['.mp4', '.webm'].includes(item.file_type)) {
            mediaHtml = `<video controls autoplay style="width:100%; max-height:75vh; object-fit:contain; background:#000; border-radius:8px;">
                <source src="${fileUrl}" type="video/mp4">
                Your browser does not support video playback.
            </video>`;
        } else if (['.png', '.jpg', '.jpeg'].includes(item.file_type)) {
            mediaHtml = `<img src="${fileUrl}" style="width:100%; max-height:75vh; object-fit:contain; border-radius:8px;">`;
        } else if (['.mp3', '.wav'].includes(item.file_type)) {
            mediaHtml = `<audio controls autoplay style="width:100%;">
                <source src="${fileUrl}" type="audio/mpeg">
            </audio>`;
        } else if (item.file_type === '.pdf') {
            mediaHtml = `<object data="${fileUrl}" type="application/pdf" style="width:100%; height:75vh; border-radius:8px;">
                <p>PDF cannot be displayed. <a href="${fileUrl}" download>Download instead</a></p>
            </object>`;
        } else if (item.file_type === '.json') {
            mediaHtml = `<div class="json-content"><pre>${escapeHtml(JSON.stringify(item, null, 2))}</pre></div>`;
        }

        previewBody.innerHTML = `
            <h2 class="preview-title">${escapeHtml(item.filename)}</h2>
            <div class="preview-meta">
                <span><strong>Type:</strong> ${item.file_type}</span>
                <span><strong>Size:</strong> ${formatSize(item.file_size)}</span>
                <span><strong>Chain:</strong> #${item.chain_position}</span>
                <span><strong>Source:</strong> ${escapeHtml(item.source_laptop || 'unknown')}</span>
            </div>
            <div class="preview-timestamps">
                <strong>Timestamp:</strong> ${formatDate(item.timestamp)}<br>
                <strong>Ingested:</strong> ${formatDate(item.ingested_at)}<br>
                <strong>Hash:</strong> <code>${item.content_hash ? item.content_hash.substring(0, 32) + '...' : 'n/a'}</code>
            </div>
            <div class="preview-media">${mediaHtml}</div>
            <div class="preview-actions">
                <a href="${fileUrl}" download="${escapeHtml(item.filename)}" class="btn btn-download">⬇️ Download</a>
                <button onclick="deleteItem(${item.id}, '${escapeHtml(item.filename)}')" class="btn btn-delete">🗑️ Delete</button>
            </div>
        `;
        previewModal.style.display = 'flex';
    } catch (error) {
        console.error('Preview failed:', error);
    }
}

async function deleteItem(itemId, filename) {
    if (!confirm(`Delete "${filename}"?\n\nThis will remove the file from disk and the database. This cannot be undone.`)) {
        return;
    }
    try {
        const response = await fetch(`${API_BASE}/api/items/${itemId}`, { method: 'DELETE' });
        const result = await response.json();
        if (result.status === 'deleted') {
            alert(`✅ Deleted: ${filename}`);
            closePreview();
            loadItems();
        }
    } catch (error) {
        alert(`❌ Delete failed: ${error.message}`);
    }
}

function closePreview() {
    previewModal.style.display = 'none';
    previewBody.innerHTML = '';
}

// ─────────────────────────────────────────────────────────────
// Mesh Status
// ─────────────────────────────────────────────────────────────
async function checkMeshStatus() {
    try {
        const responses = await Promise.all([fetch(HEALTH_ENDPOINT), fetch(PEERS_ENDPOINT)]);
        const health = await responses[0].json();
        const peers = await responses[1].json();
        meshStatusEl.textContent = '🟢 Connected';
        meshStatusEl.style.color = '#10b981';
        peerCountEl.textContent = peers.peers ? peers.peers.length : 0;
    } catch (error) {
        meshStatusEl.textContent = '🔴 Disconnected';
        meshStatusEl.style.color = '#ef4444';
        peerCountEl.textContent = '0';
    }
}

// ─────────────────────────────────────────────────────────────
// Utilities
// ─────────────────────────────────────────────────────────────
function getFileIcon(fileType) {
    const icons = {'.json':'📄','.mp4':'🎬','.webm':'🎬','.png':'🖼️','.jpg':'🖼️','.jpeg':'🖼️','.pdf':'📕','.mp3':'🎵','.wav':'🎵','.txt':'📝','.md':'📝'};
    return icons[fileType] || '📁';
}
function formatSize(bytes) {
    if (!bytes || isNaN(bytes)) return 'Unknown';
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
}
function formatDate(isoString) {
    if (!isoString) return 'Unknown';
    const date = new Date(isoString);
    return date.toLocaleDateString() + ' ' + date.toLocaleTimeString();
}
function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// ─────────────────────────────────────────────────────────────
// Event Listeners
// ─────────────────────────────────────────────────────────────
previewModal.addEventListener('click', (e) => { if (e.target === previewModal) closePreview(); });
refreshBtn.addEventListener('click', loadItems);
filterType.addEventListener('change', loadItems);
loadItems();
checkMeshStatus();
setInterval(checkMeshStatus, 10000);
JSEOF
chmod 644 "$BASE/backend/static/js/dropzone.js"
echo "  ✅ Updated dropzone.js with delete button + large modal"

# 4. UPDATE style.css — make modal much larger
cat > "$BASE/backend/static/css/style.css" << 'CSSEOF'
/* Personal Library v11.7b — Large Modal + Delete Button Styles */
:root {
    --bg-primary: #0f172a;
    --bg-secondary: #1e293b;
    --bg-tertiary: #334155;
    --text: #f1f5f9;
    --text-muted: #94a3b8;
    --accent: #3b82f6;
    --accent-hover: #2563eb;
    --success: #10b981;
    --warning: #f59e0b;
    --danger: #ef4444;
    --border: #475569;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--bg-primary);
    color: var(--text);
    min-height: 100vh;
    line-height: 1.6;
}
.container { max-width: 1400px; margin: 0 auto; padding: 2rem; }
header { text-align: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
header h1 { font-size: 2.5rem; margin-bottom: 0.5rem; }
.fleet-info { color: var(--text-muted); font-size: 0.9rem; }

/* Drop Zone */
.drop-zone {
    border: 3px dashed var(--border);
    border-radius: 12px;
    padding: 3rem;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    background: var(--bg-secondary);
    margin-bottom: 2rem;
}
.drop-zone:hover, .drop-zone.dragover {
    border-color: var(--accent);
    background: var(--bg-tertiary);
}
.drop-zone-icon { font-size: 4rem; margin-bottom: 1rem; }
.drop-zone-text { font-size: 1.2rem; margin-bottom: 0.5rem; }
.drop-zone-hint { color: var(--text-muted); font-size: 0.9rem; }

/* Stats */
.stats-section { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
.stat-card {
    background: var(--bg-secondary);
    padding: 1.5rem;
    border-radius: 8px;
    text-align: center;
    border: 1px solid var(--border);
}
.stat-number { display: block; font-size: 2rem; font-weight: bold; color: var(--accent); }
.stat-label { color: var(--text-muted); font-size: 0.9rem; }

/* Items */
.items-section { background: var(--bg-secondary); border-radius: 12px; padding: 1.5rem; }
.items-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 1rem; }
.items-header h2 { font-size: 1.5rem; }
.filter-controls { display: flex; gap: 0.5rem; align-items: center; }
.filter-controls select {
    background: var(--bg-tertiary);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
}
.btn {
    background: var(--accent);
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.9rem;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s;
}
.btn:hover { background: var(--accent-hover); }
.btn-delete { background: var(--danger); }
.btn-delete:hover { background: #dc2626; }
.btn-download { background: var(--success); }
.btn-download:hover { background: #059669; }

/* Item Cards */
.items-list { display: grid; gap: 1rem; }
.item-card {
    background: var(--bg-tertiary);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.2s;
    display: flex;
    gap: 1rem;
    align-items: center;
}
.item-card:hover { border-color: var(--accent); transform: translateY(-2px); }
.item-icon { font-size: 2.5rem; }
.item-info { flex: 1; min-width: 0; }
.item-title { font-weight: bold; margin-bottom: 0.25rem; word-break: break-all; }
.item-meta { display: flex; gap: 1rem; flex-wrap: wrap; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.25rem; }
.item-source { font-size: 0.8rem; color: var(--text-muted); }

.empty-state { text-align: center; padding: 3rem; color: var(--text-muted); }
.empty-state-icon { font-size: 3rem; margin-bottom: 1rem; }

/* Upload Progress */
.upload-progress {
    background: var(--bg-tertiary);
    padding: 1rem;
    border-radius: 6px;
    margin-top: 1rem;
}
.progress-bar {
    width: 100%;
    height: 8px;
    background: var(--bg-primary);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 0.5rem;
}
.progress-fill {
    height: 100%;
    background: var(--accent);
    width: 0%;
    transition: width 0.3s;
    animation: pulse 1.5s ease-in-out infinite;
}
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }

/* ─────────────────────────────────────────────────────────────
   Preview Modal — v11.7b (LARGE)
   ───────────────────────────────────────────────────────────── */
.preview-modal {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.85);
    z-index: 1000;
    justify-content: center;
    align-items: flex-start;
    overflow-y: auto;
    padding: 2vh 2vw;
}
.preview-content {
    background: var(--bg-primary);
    border-radius: 12px;
    width: 100%;
    max-width: 95vw;
    max-height: 96vh;
    overflow-y: auto;
    padding: 2rem;
    position: relative;
    border: 1px solid var(--border);
}
.close-btn {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: var(--bg-tertiary);
    border: none;
    color: var(--text);
    font-size: 1.5rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    z-index: 10;
}
.close-btn:hover { background: var(--danger); }
.preview-title {
    font-size: 1.3rem;
    margin-bottom: 1rem;
    padding-right: 50px;
    word-break: break-all;
    line-height: 1.4;
}
.preview-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.9rem;
}
.preview-timestamps {
    margin-bottom: 1.5rem;
    padding: 1rem;
    background: var(--bg-secondary);
    border-radius: 6px;
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.8;
}
.preview-timestamps code {
    font-family: 'Courier New', monospace;
    background: var(--bg-tertiary);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
    font-size: 0.85rem;
}
.preview-media {
    margin-bottom: 1.5rem;
    display: flex;
    justify-content: center;
    background: #000;
    border-radius: 8px;
    overflow: hidden;
}
.preview-media video,
.preview-media img,
.preview-media object {
    width: 100%;
    max-height: 75vh;
    object-fit: contain;
    display: block;
}
.json-content {
    background: var(--bg-secondary);
    padding: 1rem;
    border-radius: 6px;
    max-height: 60vh;
    overflow: auto;
}
.json-content pre {
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    white-space: pre-wrap;
    word-break: break-word;
    color: var(--text);
}
.preview-actions {
    display: flex;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
}
.preview-actions .btn {
    flex: 1;
    text-align: center;
    padding: 0.75rem 1.5rem;
    font-size: 1rem;
}

@media (max-width: 768px) {
    .container { padding: 1rem; }
    header h1 { font-size: 1.8rem; }
    .drop-zone { padding: 2rem 1rem; }
    .preview-content { padding: 1rem; max-height: 98vh; }
    .preview-meta { flex-direction: column; gap: 0.5rem; }
    .preview-actions { flex-direction: column; }
}
CSSEOF
chmod 644 "$BASE/backend/static/css/style.css"
echo "  ✅ Updated style.css with large modal styles"

# 5. UPDATE index.html — make sure modal markup exists
if ! grep -q "preview-modal" "$BASE/backend/templates/index.html"; then
cat >> "$BASE/backend/templates/index.html" << 'HTMLEOF'

<!-- Preview Modal (v11.7b) -->
<div id="preview-modal" class="preview-modal">
    <div class="preview-content">
        <button class="close-btn" onclick="closePreview()">✕</button>
        <div id="preview-body"></div>
    </div>
</div>
HTMLEOF
echo "  ✅ Added preview modal markup"
fi

# 6. Restart server
echo ""
echo "🔄 Restarting Library..."
~/library-manager/stop-all.sh
~/library-manager/start-all.sh
sleep 5
~/library-manager/health-all.sh
FIXSCRIPT

chmod +x ~/fix-modal-v11.7b.sh
~/fix-modal-v11.7b.sh
