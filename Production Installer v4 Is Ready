import os, hashlib
from pathlib import Path
from datetime import datetime
from sqlalchemy import create_engine, Column, Integer, String, BigInteger, Text, Index, func
from sqlalchemy.orm import sessionmaker, declarative_base

DATA_ROOT = Path(os.getenv("LIBRARY_DATA_ROOT", "./data"))
DB_PATH = DATA_ROOT / "db" / "library.db"
DB_PATH.parent.mkdir(parents=True, exist_ok=True)

Base = declarative_base()

class LibraryItem(Base):
    __tablename__ = "library_items"
    id = Column(Integer, primary_key=True)
    filename = Column(String(500), nullable=False)
    file_path = Column(String(1000), nullable=False)
    file_type = Column(String(50), nullable=False)
    file_size = Column(BigInteger, nullable=False)
    timestamp = Column(String(50), nullable=False, index=True)
    source_laptop = Column(String(100), nullable=False)
    ingested_at = Column(String(50), nullable=False)
    chain_position = Column(Integer, nullable=True, index=True)
    content_hash = Column(String(64), nullable=False, unique=True, index=True)
    title = Column(String(500), nullable=True)
    message_count = Column(Integer, default=0)
    content_preview = Column(Text, nullable=True)

engine = create_engine(f"sqlite:///{DB_PATH}")
Session = sessionmaker(bind=engine)

def init_db():
    Base.metadata.create_all(engine)
    print(f"Database: {DB_PATH}")

def get_item(id):
    with Session() as s:
        return s.query(LibraryItem).filter(LibraryItem.id==id).first()

def get_by_hash(h):
    with Session() as s:
        return s.query(LibraryItem).filter(LibraryItem.content_hash==h).first()

def add_item(filename, file_path, file_type, file_size, content_hash, timestamp, source, ingested, title=None, msg_count=0, preview=None):
    with Session() as s:
        max_pos = s.query(func.max(LibraryItem.chain_position)).scalar()
        item = LibraryItem(
            filename=filename, file_path=file_path, file_type=file_type,
            file_size=file_size, content_hash=content_hash, timestamp=timestamp,
            source_laptop=source, ingested_at=ingested,
            chain_position=(max_pos or 0)+1, title=title,
            message_count=msg_count, content_preview=preview
        )
        s.add(item)
        s.commit()
        s.refresh(item)
        return item

def list_items(limit=50, ftype=None):
    with Session() as s:
        q = s.query(LibraryItem).order_by(LibraryItem.chain_position)
        if ftype: q = q.filter(LibraryItem.file_type==ftype)
        return q.limit(limit).all()

def count_items(ftype=None):
    with Session() as s:
        q = s.query(func.count(LibraryItem.id))
        if ftype: q = q.filter(LibraryItem.file_type==ftype)
        return q.scalar()

def delete_item(id):
    with Session() as s:
        item = s.query(LibraryItem).filter(LibraryItem.id==id).first()
        if item:
            try:
                if os.path.exists(item.file_path):
                    os.remove(item.file_path)
            except Exception as e:
                print(f"Warning: Could not delete file {item.file_path}: {e}")
            s.delete(item)
            s.commit()
            return True
        return False
EOF
