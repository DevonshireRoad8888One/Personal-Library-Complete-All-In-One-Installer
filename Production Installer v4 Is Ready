import os, hashlib, json
from datetime import datetime
from pathlib import Path
from fastapi import FastAPI, UploadFile, File, HTTPException
from fastapi.responses import HTMLResponse, FileResponse, JSONResponse
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates
from starlette.requests import Request
from backend.app.db import init_db, get_item, get_by_hash, add_item, list_items, count_items, delete_item

PORT = int(os.getenv("LIBRARY_PORT", "8771"))
FLEET = os.getenv("LIBRARY_FLEET_NAME", "library")
DATA = Path(os.getenv("LIBRARY_DATA_ROOT", "./data"))

app = FastAPI(title="Personal Library")
app.mount("/static", StaticFiles(directory="backend/static"), name="static")
tpl = Jinja2Templates(directory="backend/templates")

@app.on_event("startup")
def start():
    init_db()
    print(f"Running at http://127.0.0.1:{PORT}")

@app.get("/", response_class=HTMLResponse)
def root(req: Request):
    return tpl.TemplateResponse("index.html", {"request": req, "fleet": FLEET, "port": PORT})

@app.get("/api/health")
def health():
    return {"status": "ok", "port": PORT}

@app.get("/api/items")
def items(ftype: str = None):
    return {"items": [i.__dict__ for i in list_items(50, ftype)], "total": count_items(ftype)}

@app.get("/api/files/{id}")
def file(id: int):
    item = get_item(id)
    if not item: raise HTTPException(404, "Not found")
    return FileResponse(item.file_path, filename=item.filename)

@app.get("/api/files/{id}/content")
def content(id: int):
    item = get_item(id)
    if not item: raise HTTPException(404, "Not found")
    with open(item.file_path) as f:
        return {"filename": item.filename, "content": f.read()}

@app.post("/api/import/upload")
async def upload(file: UploadFile = File(...)):
    ok = {".json",".mp4",".webm",".png",".jpg",".pdf",".mp3",".wav",".txt",".md"}
    ext = Path(file.filename).suffix.lower()
    if ext not in ok:
        raise HTTPException(400, f"{ext} not allowed")
    
    imports = DATA / "imports"
    imports.mkdir(parents=True, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    name = f"{ts}_{file.filename.replace(' ','_')}"
    path = imports / name
    
    data = await file.read()
    with open(path, "wb") as f:
        f.write(data)
    
    h = hashlib.sha256(data).hexdigest()
    if get_by_hash(h):
        return {"status": "duplicate"}
    
    created = datetime.fromtimestamp(path.stat().st_ctime).isoformat()
    title, preview, cnt = None, None, 0
    if ext == ".json":
        try:
            d = json.loads(data.decode())
            if isinstance(d, dict):
                title = d.get("title", "Untitled")
                msgs = d.get("messages", [])
                cnt = len(msgs)
                preview = f"{cnt} messages"
        except: pass
    
    item = add_item(name, str(path), ext, len(data), h, created, FLEET, datetime.now().isoformat(), title, cnt, preview)
    return {"status": "ok", "id": item.id}

@app.delete("/api/items/{id}")
def delete_api(id: int):
    if delete_item(id):
        return {"status": "deleted", "id": id}
    raise HTTPException(404, "Item not found")

if __name__ == "__main__":
    import uvicorn
    uvicorn.run("backend.app.main:app", host="127.0.0.1", port=PORT)
EOF
