cat > "$MANAGER/stop-all.sh" << 'EOF'
#!/usr/bin/env bash
if [ -f "$HOME/library/run/library.pid" ]; then
    kill $(cat "$HOME/library/run/library.pid") 2>/dev/null || true
    rm -f "$HOME/library/run/library.pid"
    echo "✅ Library stopped"
else
    echo "ℹ️  Not running"
fi
EOF
chmod +x "$MANAGER/stop-all.sh"

cat > "$MANAGER/health-all.sh" << 'EOF'
#!/usr/bin/env bash
echo "🔐 Personal Library Health"
echo "=========================="
if [ -f "$HOME/library/run/library.pid" ] && kill -0 $(cat "$HOME/library/run/library.pid") 2>/dev/null; then
    echo "Server: ✅ Running (PID $(cat "$HOME/library/run/library.pid"))"
else
    echo "Server: ❌ Not running"
fi
CODE=$(curl -fsS -o /dev/null -w "%{http_code}" "http://127.0.0.1:8771" 2>/dev/null || echo "000")
echo "HTTP: $([[ "$CODE" == "200" ]] && echo "✅ OK ($CODE)" || echo "⚠️  Failed ($CODE)")"
echo "DB: $([ -f "$HOME/library/data/db/library.db" ] && echo "✅ Exists" || echo "⚠️  Missing")"
EOF
chmod +x "$MANAGER/health-all.sh"
echo "   ✅ Management scripts created"

# ─────────────────────────────────────────────────────────────
# START AND TEST
# ─────────────────────────────────────────────────────────────
echo ""
echo "🚀 Starting Library..."
"$MANAGER/start-all.sh"
sleep 3

echo ""
echo "=================================================="
echo "✅ INSTALLATION COMPLETE!"
echo "=================================================="
echo ""
echo "Test it:"
echo "  1. Open: http://localhost:8771"
echo "  2. Drag & drop a test file"
echo "  3. Click to view"
echo "  4. Click 🗑️ Delete to remove"
echo ""
echo "Commands:"
echo "  Start: ~/library-manager/start-all.sh"
echo "  Stop:  ~/library-manager/stop-all.sh"
echo "  Check: ~/library-manager/health-all.sh"
echo ""
echo "Features:"
echo "  ✅ Drag & drop upload"
echo "  ✅ Video/image playback"
echo "  ✅ JSON content display"
echo "  ✅ PDF download"
echo "  ✅ Delete (list + modal)"
echo "  ✅ Timestamp chain"
echo "  ✅ Content hash dedup"
echo ""
"$MANAGER/health-all.sh"
INSTALLER

chmod +x ~/library-installer-v4.sh
