def parse_json_content(content: bytes) -> dict:
    try:
        data = json.loads(content.decode('utf-8'))
        result = {"title": None, "description": None, "message_count": 0, "content_preview": ""}
        if isinstance(data, dict):
            result["title"] = data.get("title") or data.get("chat_title") or "Untitled Chat"
            messages = data.get("messages", data.get("history", []))
        elif isinstance(data, list):
            messages = data
            result["title"] = "Chat Export"
        else:
            messages = []
        result["message_count"] = len(messages)
        previews = []
        for i, msg in enumerate(messages[:5]):
            if isinstance(msg, dict):
                role = msg.get("role", "unknown")
                content_text = msg.get("content", "")[:100]
                previews.append(f"{role}: {content_text}...")
        result["description"] = f"{len(messages)} messages"
        result["content_preview"] = "\n\n".join(previews)
        return result
    except Exception as e:
        print(f"JSON parse error: {e}")
        return {"title": None, "description": None, "message_count": 0, "content_preview": ""}

@app.post("/api/import/upload")
async def upload_file(file: UploadFile = File(...)):
    allowed = {".json", ".mp4", ".webm", ".png", ".jpg", ".jpeg", ".pdf", ".mp3", ".wav", ".txt", ".md"}
    file_ext = Path(file.filename).suffix.lower()
    if file_ext not in allowed:
        raise HTTPException(status_code=400, detail=f"File type {file_ext} not allowed")
    imports_dir = DATA_ROOT / "imports"
    imports_dir.mkdir(parents=True, exist_ok=True)
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    safe_name = f"{timestamp}_{file.filename.replace(' ', '_')}"
    file_path = imports_dir / safe_name
    file_size = 0
    content_hash = hashlib.sha256()
    with open(file_path, "wb") as buffer:
        while chunk := await file.read(1024 * 1024):
            buffer.write(chunk)
            file_size += len(chunk)
            content_hash.update(chunk)
    content_hash_hex = content_hash.hexdigest()
    existing = await get_item_by_hash(content_hash_hex)
    if existing:
        return {"status": "duplicate", "filename": safe_name, "existing_id": existing.id}
    file_stat = file_path.stat()
    created_at = datetime.fromtimestamp(file_stat.st_ctime).isoformat()
    title, description, content_preview, message_count = None, None, None, 0
    if file_ext == ".json":
        try:
            with open(file_path, 'r') as f:
                json_data = json.load(f)
            parsed = parse_json_content(json.dumps(json_data).encode())
            title = parsed["title"]
            description = parsed["description"]
            content_preview = parsed["content_preview"]
            message_count = parsed["message_count"]
        except:
            pass
    item = await create_item(filename=safe_name, file_path=str(file_path), file_type=file_ext, file_size=file_size, content_hash=content_hash_hex, timestamp=created_at, source_laptop=FLEET_NAME, ingested_at=datetime.now().isoformat(), title=title, description=description, content_preview=content_preview, message_count=message_count)
    return {"status": "accepted", "filename": safe_name, "file_size": file_size, "item_id": item.id}

