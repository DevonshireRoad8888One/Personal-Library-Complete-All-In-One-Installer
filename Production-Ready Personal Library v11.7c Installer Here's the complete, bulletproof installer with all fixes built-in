echo ""
echo "⚡ Creating JavaScript v11.7c..."
cat > "$BASE/backend/static/js/dropzone.js" << 'EOF'
const UPLOAD_ENDPOINT = '/api/import/upload';
const ITEMS_ENDPOINT = '/api/items';
const HEALTH_ENDPOINT = '/api/health';
const PEERS_ENDPOINT = '/api/mesh/peers';
const FILES_ENDPOINT = '/api/files';
const dropZone = document.getElementById('drop-zone');
const fileInput = document.getElementById('file-input');
const uploadProgress = document.getElementById('upload-progress');
const progressFill = document.getElementById('progress-fill');
const progressText = document.getElementById('progress-text');
const itemsList = document.getElementById('items-list');
const filterType = document.getElementById('filter-type');
const refreshBtn = document.getElementById('refresh-btn');
const previewModal = document.getElementById('preview-modal');
const previewBody = document.getElementById('preview-body');
const totalItemsEl = document.getElementById('total-items');
const jsonCountEl = document.getElementById('json-count');
const mediaCountEl = document.getElementById('media-count');
const peerCountEl = document.getElementById('peer-count');
const meshStatusEl = document.getElementById('mesh-status');
let allItems = [];
dropZone.addEventListener('click', () => fileInput.click());
dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-over'); });
dropZone.addEventListener('dragleave', () => { dropZone.classList.remove('drag-over'); });
dropZone.addEventListener('drop', (e) => { e.preventDefault(); dropZone.classList.remove('drag-over'); const files = e.dataTransfer.files; if (files.length > 0) handleFiles(files); });
fileInput.addEventListener('change', (e) => { const files = e.target.files; if (files.length > 0) handleFiles(files); fileInput.value = ''; });
async function handleFiles(files) { for (const file of files) await uploadFile(file); await loadItems(); }
async function uploadFile(file) { const formData = new FormData(); formData.append('file', file); uploadProgress.style.display = 'block'; progressFill.style.width = '0%'; progressText.textContent = 'Uploading ' + file.name + '...'; const xhr = new XMLHttpRequest(); xhr.upload.addEventListener('progress', (e) => { if (e.lengthComputable) progressFill.style.width = ((e.loaded / e.total) * 100) + '%'; }); xhr.addEventListener('load', () => { if (xhr.status === 200) { progressText.textContent = '✅ ' + file.name + ' uploaded!'; progressFill.style.backgroundColor = '#10b981'; setTimeout(() => { uploadProgress.style.display = 'none'; progressFill.style.width = '0%'; progressFill.style.backgroundColor = '#3b82f6'; }, 2000); } else { progressText.textContent = '❌ Upload failed'; progressFill.style.backgroundColor = '#ef4444'; } }); xhr.open('POST', UPLOAD_ENDPOINT); xhr.send(formData); }
async function loadItems() { const fileType = filterType.value; const url = fileType ? ITEMS_ENDPOINT + '?file_type=' + fileType : ITEMS_ENDPOINT; itemsList.innerHTML = '<div class="loading-state">Loading...</div>'; try { const response = await fetch(url); const data = await response.json(); allItems = data.items || []; updateStats(data); renderItems(allItems); } catch (error) { console.error('Load error:', error); itemsList.innerHTML = '<div class="empty-state"><p>Failed to load items</p></div>'; } }
function updateStats(data) { totalItemsEl.textContent = data.total || 0; const jsonCount = (data.items || []).filter(i => i.file_type === '.json').length; const mediaCount = (data.items || []).filter(i => ['.mp4','.webm','.png','.jpg','.pdf'].includes(i.file_type)).length; jsonCountEl.textContent = jsonCount; mediaCountEl.textContent = mediaCount; }
function renderItems(items) { if (!items || items.length === 0) { itemsList.innerHTML = '<div class="empty-state"><div class="empty-state-icon">💧</div><p>No items yet. Drop files above!</p></div>'; return; } let html = ''; for (const item of items) { html += '<div class="item-card" onclick="showPreview(' + item.id + ')">'; html += '<div class="item-icon">' + getFileIcon(item.file_type) + '</div>'; html += '<div class="item-info">'; html += '<div class="item-name">' + escapeHtml(item.filename) + '</div>'; html += '<div class="item-meta">'; html += '<span>' + item.file_type.toUpperCase() + '</span>'; html += '<span>' + formatSize(item.file_size) + '</span>'; html += '<span>' + formatDate(item.timestamp) + '</span>'; html += '<span class="item-chain">#' + (item.chain_position || '?') + '</span>'; html += '</div></div>'; html += '<div class="item-size">' + item.source_laptop + '</div>'; html += '</div>'; } itemsList.innerHTML = html; }
async function showPreview(itemId) { const item = allItems.find(i => i.id === itemId); if (!item) { previewBody.innerHTML = '<p>Item not found</p>'; previewModal.style.display = 'flex'; return; } let html = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem;flex-wrap:wrap;gap:1rem;">'; html += '<h2 style="font-size:1.5rem;margin:0;">' + escapeHtml(item.filename) + '</h2>'; html += '<div style="display:flex;gap:0.75rem;flex-wrap:wrap;">'; html += '<a href="' + FILES_ENDPOINT + '/' + item.id + '" download style="background:#3b82f6;color:white;padding:0.75rem 1.5rem;border-radius:8px;text-decoration:none;font-weight:600;">⬇️ Download</a>'; html += '<button onclick="deleteItem(' + item.id + ',\'' + escapeHtml(item.filename).replace(/'/g, "\\'") + '\')" style="background:#ef4444;color:white;padding:0.75rem 1.5rem;border:none;border-radius:8px;font-weight:600;cursor:pointer;">🗑️ Delete</button>'; html += '</div></div>'; html += '<div style="background:#1e293b;padding:1rem;border-radius:8px;margin-bottom:1.5rem;">'; html += '<div style="display:flex;gap:2rem;flex-wrap:wrap;">'; html += '<div><span style="color:#94a3b8;">Type:</span> <strong>' + item.file_type.toUpperCase() + '</strong></div>'; html += '<div><span style="color:#94a3b8;">Size:</span> <strong>' + formatSize(item.file_size) + '</strong></div>'; html += '<div><span style="color:#94a3b8;">Chain:</span> <strong>#' + (item.chain_position || '?') + '</strong></div>'; html += '<div><span style="color:#94a3b8;">Source:</span> <strong>' + item.source_laptop + '</strong></div>'; html += '</div></div>'; if (['.mp4', '.webm'].includes(item.file_type)) { html += '<div style="margin-top:1rem;"><video controls autoplay style="width:100%;max-height:600px;background:#000;border-radius:8px;"><source src="' + FILES_ENDPOINT + '/' + item.id + '" type="' + (item.file_type === '.mp4' ? 'video/mp4' : 'video/webm') + '">Your browser does not support video playback.</video></div>'; } else if (['.png', '.jpg', '.jpeg'].includes(item.file_type)) { html += '<div style="margin-top:1rem;text-align:center;"><img src="' + FILES_ENDPOINT + '/' + item.id + '" style="max-width:100%;max-height:600px;border-radius:8px;"></div>'; } else if (item.file_type === '.pdf') { html += '<div style="padding:2rem;text-align:center;background:#1e293b;border-radius:8px;margin-top:1rem;"><div style="font-size:3rem;margin-bottom:1rem;">📕</div><p style="color:#94a3b8;">PDF files open best in an external viewer.</p><p style="margin-top:1rem;"><strong>Click the Download button above.</strong></p></div>'; } else if (['.mp3', '.wav'].includes(item.file_type)) { html += '<div style="margin-top:1rem;"><audio controls autoplay style="width:100%;"><source src="' + FILES_ENDPOINT + '/' + item.id + '" type="' + (item.file_type === '.mp3' ? 'audio/mpeg' : 'audio/wav') + '">Your browser does not support audio playback.</audio></div>'; } else if (item.file_type === '.json') { if (item.title) html += '<p style="margin-bottom:0.5rem;"><strong>Title:</strong> ' + escapeHtml(item.title) + '</p>'; if (item.message_count) html += '<p style="margin-bottom:0.5rem;"><strong>Messages:</strong> ' + item.message_count + '</p>'; try { const response = await fetch(FILES_ENDPOINT + '/' + item.id + '/content'); const data = await response.json(); if (data.content) { html += '<div style="margin-top:1rem;"><h3 style="color:#3b82f6;margin-bottom:0.5rem;">📄 Content</h3><pre style="white-space:pre-wrap;font-family:monospace;font-size:0.85rem;background:#0f172a;padding:1rem;border-radius:8px;border:1px solid #475569;max-height:500px;overflow-y:auto;color:#f1f5f9;">' + escapeHtml(data.content) + '</pre></div>'; } } catch (e) { html += '<p style="color:#94a3b8;">Download the file to view its contents.</p>'; } } else { html += '<p style="margin-top:1rem;">Download to view this file type.</p>'; } html += '<button onclick="closePreview()" style="margin-top:1.5rem;width:100%;padding:1rem;background:#3b82f6;color:white;border:none;border-radius:8px;cursor:pointer;font-size:1rem;font-weight:600;">Close</button>'; previewBody.innerHTML = html; previewModal.style.display = 'flex'; }
async function deleteItem(itemId, filename) { if (!confirm('⚠️  DELETE THIS FILE?\n\n"' + filename + '"\n\nThis CANNOT be undone!')) { return; } try { const response = await fetch(ITEMS_ENDPOINT + '/' + itemId, { method: 'DELETE' }); const contentType = response.headers.get('content-type'); let data; if (contentType && contentType.includes('application/json')) { data = await response.json(); } else { data = { status: response.ok ? 'deleted' : 'error', detail: 'Status: ' + response.status }; } if (response.ok && data.status === 'deleted') { alert('✅ File deleted successfully!'); closePreview(); await loadItems(); } else { alert('❌ Delete failed: ' + (data.detail || 'Unknown error')); } } catch (error) { alert('❌ Delete error: ' + error.message); } }
function closePreview() { previewModal.style.display = 'none'; }
previewModal.addEventListener('click', (e) => { if (e.target === previewModal) closePreview(); });
async function checkMeshStatus() { try { const responses = await Promise.all([fetch(HEALTH_ENDPOINT), fetch(PEERS_ENDPOINT)]); const health = await responses[0].json(); const peers = await responses[1].json(); meshStatusEl.textContent = '🟢 Connected'; meshStatusEl.style.color = '#10b981'; peerCountEl.textContent = peers.peers ? peers.peers.length : 0; } catch (error) { meshStatusEl.textContent = '🔴 Disconnected'; meshStatusEl.style.color = '#ef4444'; peerCountEl.textContent = '0'; } }
function getFileIcon(fileType) { const icons = {'.json': '📄', '.mp4': '🎬', '.webm': '🎬', '.png': '🖼️', '.jpg': '🖼️', '.jpeg': '🖼️', '.pdf': '📕', '.mp3': '🎵', '.wav': '🎵', '.txt': '📝', '.md': '📝'}; return icons[fileType] || '📁'; }
function formatSize(bytes) { if (!bytes || isNaN(bytes)) return 'Unknown'; if (bytes < 1024) return bytes + ' B'; if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB'; return (bytes / (1024 * 1024)).toFixed(1) + ' MB'; }
function formatDate(isoString) { if (!isoString) return 'Unknown'; const date = new Date(isoString); return date.toLocaleDateString() + ' ' + date.toLocaleTimeString(); }
function escapeHtml(text) { if (!text) return ''; const div = document.createElement('div'); div.textContent = text; return div.innerHTML; }
refreshBtn.addEventListener('click', loadItems);
filterType.addEventListener('change', loadItems);
loadItems();
checkMeshStatus();
setInterval(checkMeshStatus, 10000);
